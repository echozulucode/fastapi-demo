# Application Settings
APP_NAME=FastAPI Intranet Demo
APP_VERSION=1.0.0
ENVIRONMENT=development

# Security (IMPORTANT: Generate a secure key for production!)
# Generate with: openssl rand -hex 32
SECRET_KEY=dev-secret-key-change-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
DATABASE_URL=sqlite:///./app.db

# CORS - Allowed origins (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# LDAP Configuration (optional - for Active Directory)
LDAP_ENABLED=false
LDAP_SERVER=ldap://dc.example.com
LDAP_PORT=389
LDAP_USE_SSL=false
LDAP_USE_NTLM=false
LDAP_BIND_DN=CN=Service Account,OU=Users,DC=example,DC=com
LDAP_BIND_PASSWORD=service-account-password
LDAP_SEARCH_BASE=OU=Users,DC=example,DC=com
LDAP_USER_SEARCH_FILTER=(sAMAccountName={username})
LDAP_GROUP_SEARCH_FILTER=(member={user_dn})
LDAP_TIMEOUT=10
# Comma-separated list of AD groups that grant admin privileges
LDAP_ADMIN_GROUPS=Domain Admins,Application Admins
# Comma-separated list of AD groups allowed to access (empty = all authenticated users)
LDAP_ALLOWED_GROUPS=

# Email Configuration (optional - for password reset)
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=smtp-password
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=FastAPI Intranet Demo

# Admin User (created on first run)
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# ── SQL Server ────────────────────────────────────────────────────────────────
# Use this when running with Docker Compose (SQL Server service)
# DATABASE_URL=mssql+pyodbc://sa:YourStrong@Passw0rd@sqlserver:1433/fastapi_demo?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
# Use this for local dev without Docker (SQLite fallback)
# DATABASE_URL=sqlite:///./app.db

# ── Keycloak / Authentication ─────────────────────────────────────────────────
# AUTH_MODE controls which JWT validator is used: "keycloak" | "local"
AUTH_MODE=local
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=fastapi-demo
KEYCLOAK_CLIENT_ID=fastapi-backend
